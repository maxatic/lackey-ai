# Supabase (required for local single-user mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # required — bypasses RLS for local-only use

# Optional: attach to an existing users.id (defaults to local-maxat-issaliyev)
# LOCAL_USER_ID=user_xxxxxxxx

# Local DB scripts only
DATABASE_URL=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=

# Anthropic (AI suggestions / generation)
ANTHROPIC_API_KEY=

# CV PDF compile service (Fly)
COMPILE_SERVICE_URL=
COMPILE_SERVICE_SECRET=

# Job search sources
APIFY_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
